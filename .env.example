# Copy to repo root `.env` and (for Next) `apps/web/.env.local` as needed.
# Fill real values from your Postgres + Clerk dashboards — leave blank until set.

# Postgres (Prisma)
DATABASE_URL=

# Clerk (API)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# Clerk (Web / Next.js)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional: expected Clerk instance id for middleware session checks
CLERK_INSTANCE_ID=

# Role in session JWT: Clerk Dashboard → Sessions → Customize session token:
# { "metadata": "{{user.public_metadata}}" }
# Default trainer sign-up: set user publicMetadata.role=TRAINER (Dashboard default
# metadata, beforeUserCreated, or webhook). Clients get role=CLIENT on invite accept.

# API / CORS
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
