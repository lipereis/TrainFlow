# =============================================================================
# TrainFlow environment — placeholders only. Never commit real secrets.
# Copy to repo root `.env` and mirror Next public/secret keys in
# `apps/web/.env.local` for local Next.js.
# Nest API loads root `.env` (and optional `apps/api/.env`) on startup.
# =============================================================================

# --- Supabase PostgreSQL (required; no SQLite) --------------------------------
# Dashboard → Project Settings → Database
# Production: DATABASE_URL = Transaction pooler (port 6543, ?pgbouncer=true)
#             DIRECT_URL   = Direct connection (port 5432) for migrations
# Local/CI:   set both to the same postgresql://… URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Clerk (production application — use pk_live_ / sk_live_ in prod) ----------
CLERK_SECRET_KEY=sk_live_YOUR_CLERK_SECRET_KEY
CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY
# Signing secret for POST /trainers/signup-webhook
CLERK_WEBHOOK_SECRET=whsec_YOUR_TRAINER_WEBHOOK_SECRET
# Signing secret for POST /invites/accept (optional; falls back to CLERK_WEBHOOK_SECRET)
CLERK_INVITE_WEBHOOK_SECRET=whsec_YOUR_INVITE_WEBHOOK_SECRET

# Web / Next.js (Vercel + local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_CLERK_PUBLISHABLE_KEY
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk Dashboard → API Keys / instance id (middleware handshake checks)
CLERK_INSTANCE_ID=ins_YOUR_PRODUCTION_INSTANCE_ID

# Session token (Clerk Dashboard → Sessions → Customize):
# { "metadata": "{{user.public_metadata}}" }
# Default trainer publicMetadata.role=TRAINER. Clients get CLIENT on invite accept.

# --- API / CORS / public URLs -------------------------------------------------
# Local:
#   NEXT_PUBLIC_API_URL=http://localhost:3001
#   WEB_ORIGIN=http://localhost:3000
#   API_PORT=3001
# Production:
#   NEXT_PUBLIC_API_URL=https://YOUR_API.up.railway.app
#   WEB_ORIGIN=https://YOUR_APP.vercel.app
#   API_PORT=3001   (Railway also injects PORT — API listens on PORT ?? API_PORT)
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
